{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-clp.local/schemas/project-0.1.0.schema.json",
  "title": "Auto CLP Project",
  "description": "Canonical persisted project data for Auto CLP Phase 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "clearancesMm",
    "cargoes",
    "containers",
    "placements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "projectId": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/displayName"
    },
    "clearancesMm": {
      "$ref": "#/$defs/clearances"
    },
    "cargoes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/cargo"
      }
    },
    "containers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "placements": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/placement"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "dimensionMm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "massGrams": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "clearanceMm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "coordinateMm": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lengthMm",
        "widthMm",
        "heightMm"
      ],
      "properties": {
        "lengthMm": {
          "$ref": "#/$defs/dimensionMm"
        },
        "widthMm": {
          "$ref": "#/$defs/dimensionMm"
        },
        "heightMm": {
          "$ref": "#/$defs/dimensionMm"
        }
      }
    },
    "position": {
      "description": "Minimum X/Y/Z corner in integer millimetres of the oriented cargo AABB, in the referenced container-local right-handed coordinate system. The container interior is [0,L] x [0,W] x [0,H], with x=0 at the negative-X opening face, +X inward, +Y left when viewed inward from the opening, and z=0 at the floor with +Z upward.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xMm",
        "yMm",
        "zMm"
      ],
      "properties": {
        "xMm": {
          "$ref": "#/$defs/coordinateMm"
        },
        "yMm": {
          "$ref": "#/$defs/coordinateMm"
        },
        "zMm": {
          "$ref": "#/$defs/coordinateMm"
        }
      }
    },
    "clearances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xMm",
        "yMm",
        "zMm"
      ],
      "properties": {
        "xMm": {
          "$ref": "#/$defs/clearanceMm"
        },
        "yMm": {
          "$ref": "#/$defs/clearanceMm"
        },
        "zMm": {
          "$ref": "#/$defs/clearanceMm"
        }
      }
    },
    "orientation": {
      "type": "string",
      "enum": [
        "LWH",
        "WLH",
        "LHW",
        "HLW",
        "WHL",
        "HWL"
      ]
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "dimensionsMm",
        "massGrams",
        "canSupportCargo",
        "allowedOrientations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "dimensionsMm": {
          "$ref": "#/$defs/dimensions"
        },
        "massGrams": {
          "$ref": "#/$defs/massGrams"
        },
        "canSupportCargo": {
          "type": "boolean"
        },
        "allowedOrientations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "default": [
            "LWH",
            "WLH"
          ],
          "items": {
            "$ref": "#/$defs/orientation"
          }
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widthMm",
        "heightMm"
      ],
      "properties": {
        "widthMm": {
          "$ref": "#/$defs/dimensionMm"
        },
        "heightMm": {
          "$ref": "#/$defs/dimensionMm"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "internalDimensionsMm",
        "openingMm",
        "payloadCapacityGrams"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "internalDimensionsMm": {
          "$ref": "#/$defs/dimensions"
        },
        "openingMm": {
          "$ref": "#/$defs/opening"
        },
        "payloadCapacityGrams": {
          "$ref": "#/$defs/massGrams"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargoId",
        "containerId",
        "positionMm",
        "orientation"
      ],
      "properties": {
        "cargoId": {
          "$ref": "#/$defs/id"
        },
        "containerId": {
          "$ref": "#/$defs/id"
        },
        "positionMm": {
          "$ref": "#/$defs/position"
        },
        "orientation": {
          "$ref": "#/$defs/orientation"
        }
      }
    }
  }
}
